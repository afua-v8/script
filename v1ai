    -- Refresh ESP nếu bật
end)

local TeleportSection = MainTab:CreateSection("Dịch chuyển")
TeleportSection:CreateTextBox("Nhập tọa độ (x,y,z)", "0,0,0", function(text)
    local t = {}
    for num in string.gmatch(text, "[^,]+") do
        table.insert(t, tonumber(num))
    end
    if #t == 3 then
        Config.TeleportPosition = Vector3.new(t[1], t[2], t[3])
        Config.AutoTeleport = true
    end
end)
TeleportSection:CreateButton("Teleport đến quái gần nhất", function()
    local m = GetClosestMonster()
    if m then
        TeleportTo(m.HumanoidRootPart.Position)
    end
end)

local StatsSection = MainTab:CreateSection("Tăng cường")
StatsSection:CreateToggle("Tăng tốc độ", function(state)
    Config.Speed = state
end)
StatsSection:CreateSlider("Tốc độ", 16, 100, 50, function(value)
    Config.SpeedValue = value
end)
StatsSection:CreateToggle("Nhảy cao", function(state)
