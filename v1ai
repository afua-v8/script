end)
FarmSection:CreateToggle("Auto Collect", function(state)
    Config.AutoCollect = state
end)
FarmSection:CreateToggle("Auto Attack", function(state)
    Config.AutoAttack = state
end)
FarmSection:CreateToggle("ESP", function(state)
